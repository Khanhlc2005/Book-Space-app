<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface_container_lowest">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Decorative vertical line representing highlight color -->
        <View
            android:id="@+id/highlight_indicator"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="#FFD54F"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Highlight Content -->
        <TextView
            android:id="@+id/txtHighlightText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="Nội dung đoạn văn bản được đánh dấu..."
            android:textColor="@color/on_surface"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.2"
            android:textStyle="italic"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/highlight_indicator"
            app:layout_constraintEnd_toStartOf="@id/btnDeleteHighlight" />

        <!-- Chapter Name / Info -->
        <TextView
            android:id="@+id/txtHighlightInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="Chương 1: Khởi đầu mới"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/txtHighlightText"
            app:layout_constraintStart_toEndOf="@id/highlight_indicator"
            app:layout_constraintEnd_toStartOf="@id/btnDeleteHighlight"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Delete button -->
        <ImageButton
            android:id="@+id/btnDeleteHighlight"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Xóa đánh dấu"
            app:tint="@color/on_surface_variant"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
