<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bottom_nav_bg"
        android:elevation="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:paddingHorizontal="16dp">

        <!-- Trang chủ -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/icon_home"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home_filled" />
            <TextView
                android:id="@+id/text_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_home"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Trang đọc -->
        <LinearLayout
            android:id="@+id/nav_reader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/icon_reader"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_auto_stories" />
            <TextView
                android:id="@+id/text_reader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_reader"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Thư viện -->
        <LinearLayout
            android:id="@+id/nav_library"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/icon_library"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_library_books" />
            <TextView
                android:id="@+id/text_library"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_library"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
